PORT=5000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API.
# On Vercel, add the deployed frontend origin, e.g. https://your-frontend.vercel.app
# localhost and 127.0.0.1 on any port are always allowed for local development.
CLIENT_ORIGIN=http://localhost:5173
# Optional. Regex for extra origins such as Vercel preview deployments, e.g.
# CLIENT_ORIGIN_REGEX=^https://your-frontend[a-z0-9-]*\.vercel\.app$

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/calvary_chapel?retryWrites=true&w=majority
MONGODB_DB_NAME=calvary_chapel
# true = use embedded MongoDB when Atlas is unreachable (development only)
USE_MEMORY_DB=true
MEMORY_DB_VERSION=4.4.29

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Leave these unset locally. On Vercel they default to SameSite=None; Secure,
# which is required because the frontend is served from a different origin.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

SUPERADMIN_NAME=Pastor Jeric Mark
SUPERADMIN_EMAIL=superadmin@calvarychapeliloilo.org
SUPERADMIN_PASSWORD=Calvary@2026
ADMIN_NAME=Church Admin
ADMIN_EMAIL=admin@calvarychapeliloilo.org
ADMIN_PASSWORD=Admin@2026
